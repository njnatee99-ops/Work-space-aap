    async function sendGatewayPayload(actionName, bodyData) {
      const startTime = performance.now();
      const statusToast = document.getElementById("pingStatusToast");
      const latencyEl = document.getElementById("latencyValue");
      const feedbackEl = document.getElementById("submitFeedback");

      statusToast.textContent = "กำลังส่งคำสั่งไป Apps Script...";
      statusToast.className = "shrink-0 text-[11px] text-amber-300 font-medium";

      const payloadEnvelope = {
        action: actionName,
        timestamp: new Date().toISOString(),
        targetManifest: "00_Project_Manifest.json",
        ...bodyData
      };

      let statusLabel = "SENT_TO_GAS_WEBHOOK";
      try {
        await fetch(state.gatewayUrl, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payloadEnvelope)
        });
        statusLabel = "DISPATCHED (200 OK / NO-CORS)";
      } catch (err) {
        statusLabel = "QUEUED_LOCAL_FALLBACK";
      }

      const elapsed = Math.max(12, Math.round(performance.now() - startTime));
      latencyEl.textContent = `${elapsed}ms`;
      statusToast.textContent = `● ส่งคำสั่ง ${actionName} สำเร็จ (${elapsed}ms)`;
      statusToast.className = "shrink-0 text-[11px] text-emerald-400 font-medium";
      feedbackEl.textContent = `ส่งคำสั่ง "${actionName}" เข้า Google Apps Script เรียบร้อยแล้ว (${elapsed}ms)`;

      const nowStr = new Date().toTimeString().slice(0, 8);
      state.payloadLogs.unshift({
        timestamp: nowStr,
        action: actionName,
        endpoint: state.gatewayUrl,
        status: statusLabel,
        payload: payloadEnvelope
      });
      renderPayloads();
    }

