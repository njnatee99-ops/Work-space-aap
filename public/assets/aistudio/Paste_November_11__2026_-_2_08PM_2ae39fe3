    document.getElementById("formExpandScope").addEventListener("submit", (e) => {
      e.preventDefault();
      const code = document.getElementById("inputScopeCode").value.trim() || `CRD-SCOPE-0${state.scopes.length + 1}`;
      const title = document.getElementById("inputScopeTitle").value.trim();
      const gate = document.getElementById("selectScopeGate").value;
      const rule = document.getElementById("inputScopeRule").value.trim() || "ยึดตามกฎมาตรฐาน CRD และ PDPA Zero-PII";
      if (!title) return;

      const newScope = {
        id: code,
        title,
        gate,
        rule,
        status: "ACTIVE_SYNCED",
        updatedAt: new Date().toISOString().slice(0, 16).replace("T", " ")
      };
      state.scopes.unshift(newScope);
      renderScopes();
      sendGatewayPayload("APPEND_NEW_SCOPE", { scope: newScope });

      document.getElementById("inputScopeCode").value = `CRD-SCOPE-0${state.scopes.length + 1}`;
      document.getElementById("inputScopeTitle").value = "";
      document.getElementById("inputScopeRule").value = "";
